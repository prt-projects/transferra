<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Transferra Download</title>

    <link rel="stylesheet"
        href="/public/style1.css">

</head>

<body>

    <!-- PARTICLES -->

    <div class="particles"></div>

    <!-- LOGO -->

    <div class="topLogo">

        <img src="/img/logo.png" alt="">

    </div>

    <!-- DOWNLOAD SECTION -->

    <section class="download-page">

        <% if(locals.error){ %>

        <div class="download-card">

            <h2 class="error-text">

                <%= locals.error %>

            </h2>

        </div>

        <% } else { %>

        <div class="download-card">

            <img class="download-icon"
                src="/img/download-sd.svg"
                alt="download">

            <h1>

                Your File is Ready ⚡

            </h1>

            <p>

                Link expires in 24 hours

            </p>

            <!-- FILE INFO -->

            <div class="download-meta">

                <h4>

                    <%= fileName %>

                </h4>

                <small>

                    <%= parseInt(fileSize/1000) %> KB

                </small>

            </div>

            <!-- BUTTON -->

            <a href="<%= downloadLink %>"
                class="download-btn">

                Download File

            </a>

        </div>

        <% } %>

    </section>

</body>

</html>